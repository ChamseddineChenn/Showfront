MONGODB_URI=mongodb://localhost:27017/example
PORT=3000
# JWT Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# JWT Expiration
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

# CORS
FRONTEND_URL=http://localhost:3000

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Email Configuration (add these)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=user@example.com
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=noreply@example.com

# Token Expiration
EMAIL_VERIFICATION_EXPIRATION=24h
PASSWORD_RESET_EXPIRATION=1h

# Stripe configuration
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Cloudinary Configuration (Server-Side)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# QR Encryption Key (required - the API refuses to start without a valid value)
# Exactly 64 hexadecimal characters = 32 bytes, the key size for aes-256-gcm.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Migrating from the old format (QR codes issued before this change used the
# first 32 characters of the old value as raw bytes)? Keep those QR codes valid with:
# node -e "console.log(Buffer.from(process.argv[1].padEnd(32,'0').slice(0,32)).toString('hex'))" "<old value>"
QR_ENCRYPTION_KEY=replace-with-64-hex-characters

# Transactional mail. The API speaks the SendGrid mail-send request.
# Default host is Mailroomly. SENDGRID_FROM_EMAIL must be a verified sender there.
SENDGRID_API_KEY=replace-with-mail-api-key
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=Showfront
SENDGRID_BASE_URL=https://app.mailroomly.com/

# Email Configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM_NAME=Example App

# OAuth Configuration
# Google OAuth - Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Facebook OAuth - Get credentials from https://developers.facebook.com/apps
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
